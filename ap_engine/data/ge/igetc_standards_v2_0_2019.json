            "transfer_scope": [
              "CSU",
              "UC"
            ],
            "ap_allowed": false,
            "ib_allowed": false,
            "prerequisite_area": "1A",
            "notes": [
              "Course must combine critical thinking with substantial composition.",
              "No AP or IB exam may satisfy this area."
            ]
          },
          {
            "id": "1C",
            "name": "Oral Communication",
            "courses_required": 1,
            "minimum_semester_units": 3,
