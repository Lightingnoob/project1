            "transfer_scope": [
              "CSU",
              "UC"
            ],
            "ap_allowed": true,
            "ib_allowed": false,
            "notes": [
              "First-semester English reading and written composition.",
              "The standards specify substantial college-level expository writing and reading.",
              "Successful completion of 1A is a prerequisite to 1B."
            ]
          },
          {
            "id": "1B",
            "name": "Critical Thinking and Composition",
            "courses_required": 1,
            "minimum_semester_units": 3,
